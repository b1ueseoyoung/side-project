{
  "name": "side-project",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mts",
    "build": "next build",
    "start": "next start -H 127.0.0.1",
    "lint": "eslint",
    "diagnose": "node --env-file-if-exists=.env.local --conditions=react-server scripts/diagnose.mts",
    "eval": "node --env-file-if-exists=.env.local --conditions=react-server scripts/eval/run.mts",
    "eval:score": "node scripts/eval/score.mts",
    "test": "node --conditions=react-server --test src/lib/diagnosis/diagnose.test.ts scripts/eval/lib.test.ts",
    "test:eval": "node --test scripts/eval/lib.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file=.env.local node_modules/drizzle-kit/bin.cjs migrate"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "better-auth": "^1.7.6",
    "drizzle-orm": "^0.45.3",
    "next": "16.3.6",
    "nodemailer": "^10.0.12",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "type": "module"
}
