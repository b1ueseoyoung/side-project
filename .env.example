# Copy to .env.local (on your Mac) or set in Vercel > Settings > Environment Variables.
# Never commit real values: this repository is public.

# Neon Postgres connection string (Vercel > Storage > Neon creates it)
DATABASE_URL=

# Emails that may log in, comma separated (you and your friend)
ALLOWED_EMAILS=
# Your email: in local mode (no login) reports are saved under it
OWNER_EMAIL=

# --- Mac only ---------------------------------------------------------------
# Skips login on your Mac (127.0.0.1 only). Never set this on Vercel (it is ignored there anyway).
APP_MODE=local

# --- Mac and Vercel ---
# OpenAI API key for diagnoses (server only; never commit it)
OPENAI_API_KEY=
# Optional: model and reasoning effort (defaults gpt-6-luna, max)
# OPENAI_MODEL=
# OPENAI_EFFORT=

# --- Vercel only ------------------------------------------------------------
# Random secret, e.g. `openssl rand -base64 32`
BETTER_AUTH_SECRET=
# The deployed URL, e.g. https://your-app.vercel.app
BETTER_AUTH_URL=
# SMTP for login links, e.g. Gmail with an app password:
# smtps://you%40gmail.com:app-password@smtp.gmail.com:465
SMTP_URL=
SMTP_FROM=
