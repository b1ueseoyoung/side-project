# Copy to .env.local (on your Mac) or set in Vercel > Settings > Environment Variables.
# Never commit real values: this repository is public.

# Neon Postgres connection string (Vercel > Storage > Neon creates it)
DATABASE_URL=

# Emails that may log in, comma separated (you and your friend)
ALLOWED_EMAILS=
# Your email: reports you diagnose on the Mac are saved under it
OWNER_EMAIL=

# --- Mac only ---------------------------------------------------------------
# Turns on diagnosis with your local Claude Code login. Never set this on Vercel
# (it is ignored there anyway).
APP_MODE=local
# Optional: model and effort for `claude -p` (default claude-opus-5-5 at max;
# max takes minutes per memo, lower it with e.g. high), and the claude binary
# CLAUDE_MODEL=
# CLAUDE_EFFORT=
# CLAUDE_BIN=

# --- Vercel only ------------------------------------------------------------
# Random secret, e.g. `openssl rand -base64 32`
BETTER_AUTH_SECRET=
# The deployed URL, e.g. https://your-app.vercel.app
BETTER_AUTH_URL=
# SMTP for login links, e.g. Gmail with an app password:
# smtps://you%40gmail.com:app-password@smtp.gmail.com:465
SMTP_URL=
SMTP_FROM=
